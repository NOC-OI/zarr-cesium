{
  "name": "zarr-cesium",
  "version": "0.2.0",
  "description": "A Cesium integration library for visualizing Zarr datasets in 2D and 3D.",
  "author": "Tobias <tobias.ferreira@noc.ac.uk>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup src/index.ts --format cjs,esm --dts --sourcemap --external cesium-wind-layer --external zarrita --external zarr-maps-colormap --watch",
    "build": "tsup src/index.ts --format esm --dts --sourcemap --external cesium --external cesium-wind-layer --external zarrita --external zarr-maps-colormap",
    "clean": "rm -rf dist",
    "docs": "npm --prefix docs run build",
    "serve:docs": "npm --prefix docs run serve",
    "start:demo": "cd demo && npm run dev"
  },
  "peerDependencies": {
    "cesium": ">=1.119.0 <2"
  },
  "dependencies": {
    "cesium-wind-layer": "https://github.com/NOC-OI/cesium-wind-layer/releases/download/v0.11.1/cesium-wind-layer-0.11.1.tgz",
    "zarr-maps-colormap": "^0.2.0",
    "zarr-maps-tiling": "^0.2.0",
    "zarrita": "^0.7.4"
  },
  "devDependencies": {
    "@types/ndarray": "^1.0.14",
    "cesium": "1.142.0",
    "ndarray": "^1.0.19",
    "proj4": "^2.19.10",
    "tsup": "^8.0.2",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NOC-OI/zarr-cesium.git"
  },
  "bugs": {
    "url": "https://github.com/NOC-OI/zarr-cesium/issues"
  },
  "homepage": "https://noc-oi.github.io/zarr-cesium",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
